<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Vista 1: Lista de Órdenes -->
    <VBox fx:id="vistaListaOrdenes" spacing="15">
        <Label text="Conciliación de Inventario" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label text="Órdenes de compra entregadas disponibles para conciliar:"/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="contenedorOrdenes" spacing="10">
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblMensajeExito" text="Los cambios se hicieron correctamente." textFill="#2e7d32" visible="false" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar" onAction="#handleCerrar" style="-fx-min-width: 100px;"/>
        </HBox>
    </VBox>

    <!-- Vista 2: Detalle de Conciliación -->
    <ScrollPane fx:id="scrollDetalle" fitToWidth="true" visible="false" style="-fx-background-color: transparent;">
        <content>
            <VBox fx:id="vistaDetalleConciliacion" spacing="15">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>
