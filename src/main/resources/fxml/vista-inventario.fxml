<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      spacing="10" style="-fx-padding: 15px;" prefWidth="360">
    
    <Label text="PixelForge" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Control de inventario" style="-fx-text-fill: #52606d;" />

    <Separator />

    <VBox spacing="8">
        <Button text="Inventario" onAction="#handleInventario" prefWidth="220" prefHeight="38" style="-fx-font-weight: bold;"/>
        <Button text="Registrar Producto" onAction="#handleRegistrarProducto" prefWidth="220" prefHeight="38" style="-fx-font-weight: bold;"/>
        <Button text="Punto de Venta" onAction="#handlePuntoVenta" prefWidth="220" prefHeight="38" style="-fx-font-weight: bold;"/>
    </VBox>

</VBox>
