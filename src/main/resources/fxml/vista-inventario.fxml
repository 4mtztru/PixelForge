<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      spacing="10" style="-fx-padding: 15px;">
    
    <Label text="PixelForge" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Control de inventario" style="-fx-text-fill: #52606d;" />

    <Button text="Inventario" onAction="#handleInventario"
            style="-fx-min-width: 200px; -fx-min-height: 38px; -fx-font-weight: bold;"/>

    <Separator />
    
    <Button text="Listar usuarios" onAction="#handleListarUsuarios" 
            style="-fx-min-width: 200px; -fx-min-height: 30px;"/>

</VBox>
