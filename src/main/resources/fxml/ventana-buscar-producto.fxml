<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Buscar Producto"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Ingrese un solo criterio y presione Enter para buscar."/>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Nombre del producto:"/>
            <TextField fx:id="textNombreProducto" promptText="Nombre del producto"
                       onAction="#handleBuscar"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="SKU:"/>
            <TextField fx:id="textSku" promptText="SKU"
                       onAction="#handleBuscar"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Código de barras:"/>
            <TextField fx:id="textCodigoBarras" promptText="Código de barras"
                       onAction="#handleBuscar"/>
        </VBox>
    </HBox>

    <Label fx:id="labelMensaje"/>

    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
            <TableColumn fx:id="colNombre" text="Producto" prefWidth="200"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="170"/>
            <TableColumn fx:id="colStockActual" text="Stock" prefWidth="160"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Limpiar búsqueda" onAction="#limpiarBusqueda"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar" onAction="#handleCerrar"/>
    </HBox>
</VBox>
