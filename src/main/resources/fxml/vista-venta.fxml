<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      spacing="14" style="-fx-padding: 20px; -fx-background-color: #f8fafc;" prefWidth="750" prefHeight="600">

    <fx:define>
        <ToggleGroup fx:id="grupoMetodoPago"/>
    </fx:define>

    <Label text="Punto de Venta y Cobro (HU-03)" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <Label fx:id="etiquetaMensaje" wrapText="true" visible="false" managed="false" 
           style="-fx-padding: 10px; -fx-background-radius: 6px; -fx-font-weight: bold;"/>

    <HBox spacing="15" VBox.vgrow="ALWAYS">

        <!-- Selector de Productos de la BD y Carrito -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="420">
            <Label text="Productos Disponibles" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TableView fx:id="tablaCatalogo" prefHeight="160">
                <columns>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="170"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                </columns>
            </TableView>
            <Button text="➕ Añadir al Carrito" onAction="#handleAgregarCarrito" 
                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Label text="Carrito de Compras" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <ListView fx:id="listaCarrito" prefHeight="140"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Limpiar Carrito" onAction="#handleLimpiarCarrito"/>
                <Label text="Total a Pagar:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="etiquetaTotal" text="$0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
            </HBox>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <!-- Panel de Cobro y Método de Pago -->
        <VBox spacing="12" prefWidth="280">
            <Label text="Método de Pago" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <RadioButton fx:id="radioEfectivo" text="Efectivo" toggleGroup="$grupoMetodoPago" selected="true" onAction="#handleCambioMetodo"/>
            <RadioButton fx:id="radioTarjeta" text="Tarjeta de Crédito/Débito" toggleGroup="$grupoMetodoPago" onAction="#handleCambioMetodo"/>
            <RadioButton fx:id="radioTransferencia" text="Transferencia Bancaria" toggleGroup="$grupoMetodoPago" onAction="#handleCambioMetodo"/>

            <Separator/>

            <!-- Panel Efectivo -->
            <VBox fx:id="panelEfectivo" spacing="8">
                <Label text="Monto Recibido ($):" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtMontoRecibido" promptText="0.00"/>
                <Button text="Calcular Cambio" onAction="#handleCalcularCambio" style="-fx-background-color: #e2e8f0;"/>
                <Label fx:id="etiquetaCambio" text="Cambio: $0.00" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            </VBox>

            <!-- Panel Tarjeta -->
            <VBox fx:id="panelTarjeta" spacing="8" visible="false" managed="false">
                <Label text="Código de Autorización:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtAutorizacionTarjeta" promptText="Ej. AUTH-987654"/>
            </VBox>

            <!-- Panel Transferencia -->
            <VBox fx:id="panelTransferencia" spacing="8" visible="false" managed="false">
                <Label text="Banco Origen:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtBanco" promptText="Ej. BBVA / Banamex"/>
                <Label text="Referencia Bancaria:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtReferencia" promptText="Ej. REF-12345678"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="💳 Confirmar y Cobrar" onAction="#handleProcesarCobro" prefWidth="280" prefHeight="42"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
</VBox>
